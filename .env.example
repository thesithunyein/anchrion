# Anchrion environment variables
#
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# Every variable is optional. Anchrion runs with no keys at all on public RPC and
# public explorer endpoints; the variables below only raise rate limits, pin a
# value we would otherwise measure, or let you supply your own threat list.

# Site URL. Used for MetaMask's connector metadata, which refuses to initialise
# without a dapp URL. Not needed in the browser (it reads window.location) but
# required for a clean server build and for self-hosted deployments.
NEXT_PUBLIC_SITE_URL=

# WalletConnect project id (https://cloud.reown.com).
# Without it WalletConnect is hidden; MetaMask, Coinbase Wallet and Phantom
# injection still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Optional: per-chain explorer API overrides.
# Anchrion reads history from a keyless Blockscout v2 endpoint by default (see
# src/lib/explorer/blockscout.ts). Set these to point at your own
# Etherscan-compatible API instead.
NEXT_PUBLIC_EXPLORER_API_MAINNET=
NEXT_PUBLIC_EXPLORER_API_SEPOLIA=
NEXT_PUBLIC_EXPLORER_API_BASE=
NEXT_PUBLIC_EXPLORER_API_ARBITRUM=
NEXT_PUBLIC_EXPLORER_API_OPTIMISM=

# Optional: pin the approval-event log window (in blocks) instead of probing for
# it. Only useful if you run your own archive-capable RPC node; public endpoints
# refuse wide eth_getLogs ranges and the scan reports whatever window it reached.
NEXT_PUBLIC_LOG_WINDOW_BLOCKS=

# Optional: your own list of addresses you consider malicious, comma separated.
# Anchrion ships NO threat intelligence of its own and will not claim any. If you
# set this, matching spenders gain +50 and are labelled as coming from your list.
NEXT_PUBLIC_THREAT_LIST=
